# =============================================================================
# FOMO Firewall — environment template.
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# ── Birdeye (server-only) ────────────────────────────────────────────────────
# Required for the worker to fetch trending tokens + enrich snapshots.
# The web app, extension, and Telegram bot NEVER read this — only the worker
# and the local MCP server are allowed to import it.
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_CHAIN=solana
BIRDEYE_RPS=8                            # Token-bucket rate limit.

# ── Worker tuning ────────────────────────────────────────────────────────────
FOMO_TRENDING_LIMIT=25                   # Tokens scored per pass.
FOMO_DB_DRIVER=memory                    # `memory` (default) or `supabase`.
FOMO_DEMO_MODE=                          # Set to 1 to force fixture mode.

# ── Web app ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# ── Database (server-only) ───────────────────────────────────────────────────
# Used by the Supabase implementation (forthcoming). The in-memory driver
# ignores these.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram bot (server-only) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=                  # Optional broadcast channel.
BOT_API_BASE_URL=http://localhost:3000   # Where the bot fetches scores from.

# ── Extension ────────────────────────────────────────────────────────────────
EXTENSION_API_BASE_URL=http://localhost:3000

# ── Worker HTTP /run (production cron auth) ──────────────────────────────────
WORKER_SECRET=
