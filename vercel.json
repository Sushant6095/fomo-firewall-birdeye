{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @fomo/web build",
  "installCommand": "pnpm install --frozen-lockfile=false",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "regions": ["iad1"],
  "functions": {
    "app/api/worker/run/route.ts": {
      "maxDuration": 60
    },
    "app/api/source/status/route.ts": {
      "maxDuration": 60
    },
    "app/api/tokens/trending-risk/route.ts": {
      "maxDuration": 60
    },
    "app/api/alerts/recent/route.ts": {
      "maxDuration": 30
    },
    "app/api/token/[address]/score/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/worker/run",
      "schedule": "0 12 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "x-frame-options", "value": "DENY" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
