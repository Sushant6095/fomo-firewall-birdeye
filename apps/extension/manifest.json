{
  "manifest_version": 3,
  "name": "FOMO Firewall",
  "short_name": "Firewall",
  "version": "1.0.0",
  "description": "Solana exit-liquidity intelligence. See when smart wallets, insiders, and top holders are using retail FOMO as exit liquidity.",
  "author": "Sushant Jain",
  "homepage_url": "https://github.com/Sushant6095/fomo-firewall-birdeye",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://birdeye.so/*",
    "https://dexscreener.com/*",
    "https://www.dextools.io/*",
    "https://solscan.io/*",
    "https://pump.fun/*",
    "https://jup.ag/*",
    "https://fomo-firewall-birdeye.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FOMO Firewall — TrapScore",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://birdeye.so/*",
        "https://dexscreener.com/*",
        "https://www.dextools.io/*",
        "https://solscan.io/*",
        "https://pump.fun/*",
        "https://jup.ag/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
